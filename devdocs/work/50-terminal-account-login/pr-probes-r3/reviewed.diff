+                assert not pending
+                if mode=='keyboard_cancel':payload=b'\x03'
+                elif mode=='keyboard_discard':payload=b'x'*5000
+                elif (mode.startswith('first_') and phase==target_phase and mode.endswith('_eof')) or (mode=='after_restore_eof' and phase=='phone'):
