+                except OSError:block=b''
+                if not block:break
+                data.extend(block)
+            text=data.decode(errors='replace')
+            for phase,marker in PROMPTS.items():
+                if text.count(marker)>seen.get(phase,0):
+                    seen[phase]=text.count(marker)
